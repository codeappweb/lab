---
[
{% for i in site.posts %}
{"title": {{ i.title | jsonify }},"url": {{ i.url | relative_url | jsonify }},"description": {{ i.description | default: '' | strip_html | strip | jsonify }},"category": {{ i.cluster | default: '' | jsonify }},"kind": "bai","headings": [{% assign parts = i.content | split: '<h' %}{% for part in parts offset: 1 %}{{ part | split: '</h' | first | split: '>' | last | strip | jsonify }}{% unless forloop.last %},{% endunless %}{% endfor %}],"keywords": [{{ i.cluster | jsonify }}]}{% unless forloop.last %},{% endunless %}
{% endfor %}
{% assign hubs = site.pages | where: 'layout', 'hub' %}
{% if hubs.size > 0 and site.posts.size > 0 %},{% endif %}
{% for h in hubs %}
{"title": {{ h.title | jsonify }},"url": {{ h.url | relative_url | jsonify }},"description": {{ h.description | default: '' | strip_html | strip | jsonify }},"category": {{ h.cluster | default: '' | jsonify }},"kind": "hub","headings": [],"keywords": [{{ h.cluster | jsonify }}]}{% unless forloop.last %},{% endunless %}
{% endfor %}
]
