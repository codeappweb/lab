---
---
{% assign items = site.posts %}
[
{% for i in items %}
{% assign t = site.data['article-taxonomy'][i.slug] %}
{"title": {{ i.title | jsonify }},"url": {{ i.url | relative_url | jsonify }},"description": {{ i.description | default: '' | strip_html | strip | jsonify }},"category": {{ i.cluster | default: '' | jsonify }},"kind": "bai","parent": {{ i.parent_category | default: t.parent | default: '' | jsonify }},"child": {{ i.child_category | default: t.child | default: '' | jsonify }},"headings": [{% assign parts = i.content | split: '<h' %}{% for part in parts offset: 1 %}{{ part | split: '</h' | first | split: '>' | last | strip | jsonify }}{% unless forloop.last %},{% endunless %}{% endfor %}],"keywords": [{{ i.cluster | jsonify }}]}{% unless forloop.last %},{% endunless %}
{% endfor %}
{% assign hubs = site.pages | where: 'layout', 'hub' %}
{% if hubs.size > 0 and items.size > 0 %},{% endif %}
{% for h in hubs %}
{"title": {{ h.title | jsonify }},"url": {{ h.url | relative_url | jsonify }},"description": {{ h.description | default: '' | strip_html | strip | jsonify }},"category": {{ h.cluster | default: '' | jsonify }},"kind": "hub","parent": "","child": "","headings": [],"keywords": [{{ h.cluster | jsonify }}]}{% unless forloop.last %},{% endunless %}
{% endfor %}
{% assign catp = site.pages | where: 'layout', 'parent-category' %}
{% if catp.size > 0 and (hubs.size > 0 or items.size > 0) %},{% endif %}
{% for c in catp %}
{"title": {{ c.title | jsonify }},"url": {{ c.url | relative_url | jsonify }},"description": {{ c.description | default: '' | strip_html | strip | jsonify }},"category": "","kind": "danh-muc","parent": {{ c.pslug | default: '' | jsonify }},"child": "","headings": [],"keywords": [{{ c.pslug | default: '' | jsonify }}]}{% unless forloop.last %},{% endunless %}
{% endfor %}
{% assign catc = site.pages | where: 'layout', 'child-category' %}
{% if catc.size > 0 and (catp.size > 0 or hubs.size > 0 or items.size > 0) %},{% endif %}
{% for c in catc %}
{"title": {{ c.title | jsonify }},"url": {{ c.url | relative_url | jsonify }},"description": {{ c.description | default: '' | strip_html | strip | jsonify }},"category": "","kind": "danh-muc","parent": {{ c.pslug | default: '' | jsonify }},"child": {{ c.cslug | default: '' | jsonify }},"headings": [],"keywords": [{{ c.cslug | default: '' | jsonify }}]}{% unless forloop.last %},{% endunless %}
{% endfor %}
]
