---
---
{% assign found = false %}
[
{% for i in site.posts %}
{% if found %},{% endif %}{% assign found = true %}
{% assign t = site.data['article-taxonomy'][i.slug] %}
{"title": {{ i.title | jsonify }},"url": {{ i.url | relative_url | jsonify }},"desc": {{ i.description | default: '' | strip_html | strip | jsonify }},"cluster": {{ i.cluster | default: '' | jsonify }},"parent": {{ i.parent_category | default: t.parent | default: '' | jsonify }},"child": {{ i.child_category | default: t.child | default: '' | jsonify }},"kind": "bai"}
{% endfor %}
{% for c in site.pages %}
{% if c.layout == 'parent-category' and c.noindex != true and c.url contains 'undefined' == false %}
{% if found %},{% endif %}{% assign found = true %}
{"title": {{ c.title | jsonify }},"url": {{ c.url | relative_url | jsonify }},"desc": {{ c.description | default: '' | strip_html | strip | jsonify }},"cluster": "","parent": {{ c.pslug | default: '' | jsonify }},"child": "","kind": "danh-muc"}
{% endif %}
{% endfor %}
{% for c in site.pages %}
{% if c.layout == 'child-category' and c.noindex != true and c.url contains 'undefined' == false %}
{% if found %},{% endif %}{% assign found = true %}
{"title": {{ c.title | jsonify }},"url": {{ c.url | relative_url | jsonify }},"desc": {{ c.description | default: '' | strip_html | strip | jsonify }},"cluster": "","parent": {{ c.pslug | default: '' | jsonify }},"child": {{ c.cslug | default: '' | jsonify }},"kind": "danh-muc"}
{% endif %}
{% endfor %}
]
