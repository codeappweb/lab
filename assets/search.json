---
---
{% assign items = site.posts %}
[
{% for i in items %}
{% assign t = site.data['article-taxonomy'][i.slug] %}
{"title": {{ i.title | jsonify }},"url": {{ i.url | relative_url | jsonify }},"desc": {{ i.description | default: '' | strip_html | strip | jsonify }},"cluster": {{ i.cluster | default: '' | jsonify }},"parent": {{ i.parent_category | default: t.parent | default: '' | jsonify }},"child": {{ i.child_category | default: t.child | default: '' | jsonify }},"kind": "bai"}{% unless forloop.last %},{% endunless %}
{% endfor %}
{% assign hubs = site.pages | where: 'layout', 'hub' %}
{% if hubs.size > 0 and items.size > 0 %},{% endif %}
{% for h in hubs %}
{"title": {{ h.title | jsonify }},"url": {{ h.url | relative_url | jsonify }},"desc": {{ h.description | default: '' | strip_html | strip | jsonify }},"cluster": {{ h.cluster | default: '' | jsonify }},"kind": "hub"}{% unless forloop.last %},{% endunless %}
{% endfor %}
{% assign catp = site.pages | where: 'layout', 'parent-category' %}
{% if catp.size > 0 and (hubs.size > 0 or items.size > 0) %},{% endif %}
{% for c in catp %}
{"title": {{ c.title | jsonify }},"url": {{ c.url | relative_url | jsonify }},"desc": {{ c.description | default: '' | strip_html | strip | jsonify }},"cluster": "","parent": {{ c.pslug | default: '' | jsonify }},"child": "","kind": "danh-muc"}{% unless forloop.last %},{% endunless %}
{% endfor %}
{% assign catc = site.pages | where: 'layout', 'child-category' %}
{% if catc.size > 0 and (catp.size > 0 or hubs.size > 0 or items.size > 0) %},{% endif %}
{% for c in catc %}
{"title": {{ c.title | jsonify }},"url": {{ c.url | relative_url | jsonify }},"desc": {{ c.description | default: '' | strip_html | strip | jsonify }},"cluster": "","parent": {{ c.pslug | default: '' | jsonify }},"child": {{ c.cslug | default: '' | jsonify }},"kind": "danh-muc"}{% unless forloop.last %},{% endunless %}
{% endfor %}
]
